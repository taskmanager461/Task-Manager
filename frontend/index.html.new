<!-- Trust Progress Card -->
<div class="card trust-progress-card" style="margin-bottom: 1.5rem;">
<div class="identity-header">
<div class="identity-title-group">
<div class="identity-avatar-icon" style="background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); border: 2.2px solid rgba(0, 198, 255, 0.45); box-shadow: 0 4px 14px rgba(0, 114, 255, 0.35);">
<i class="fas fa-shield-halved" style="color: #ffffff !important; font-size: 1.1rem;"></i>
</div>
<h3 data-i18n="self_trust_score">Self Trust Score</h3>
</div>
