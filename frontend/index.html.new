</div>
<div class="ach-stat ach-stat-rare">
<span class="ach-stat-value" id="ach-count-rare">0</span>
<span class="ach-stat-label" data-i18n="rare">Rare</span>
</div>
<div class="ach-stat ach-stat-epic">
<span class="ach-stat-value" id="ach-count-epic">0</span>
<span class="ach-stat-label" data-i18n="epic">Epic</span>
</div>
<div class="ach-stat ach-stat-legendary">
<span class="ach-stat-value" id="ach-count-legendary">0</span>
<span class="ach-stat-label" data-i18n="legendary">Legendary</span>
</div>
</div>
<!-- Toggle Button to Show/Hide achievements content -->
<div style="margin-top: 1rem; text-align: center;">
<button class="btn primary" id="toggle-achievements-btn" onclick="toggleAchievementsVisibility()" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.65rem 1rem;">
<span data-i18n="achievements">View Achievements</span>
<i class="fas fa-chevron-down" id="toggle-achievements-chevron"></i>
</button>
</div>
<!-- Toggleable wrapper (collapsed by default) -->
<div id="achievements-collapse-wrapper" style="display: none; margin-top: 1.25rem;">
<div class="achievements-search-wrap">
<i class="fas fa-search achievements-search-icon"></i>
<input class="achievements-search" data-i18n="search_achievements" id="achievements-search" placeholder="Search achievements..." type="text"/>
</div>
<div class="achievements-filters" id="achievements-filters">
<button class="ach-filter-btn active" data-filter="All" data-i18n="all" onclick="filterAchievements('All', this)">All</button>
<button class="ach-filter-btn" data-filter="Tasks" onclick="filterAchievements('Tasks', this)">📋 <span data-i18n="tasks">Tasks</span></button>
<button class="ach-filter-btn" data-filter="Goals" onclick="filterAchievements('Goals', this)">🎯 <span data-i18n="goals">Goals</span></button>
<button class="ach-filter-btn" data-filter="Habits" onclick="filterAchievements('Habits', this)">⚡ <span data-i18n="habits">Habits</span></button>
<button class="ach-filter-btn" data-filter="Streaks" onclick="filterAchievements('Streaks', this)">🔥 <span data-i18n="streak">Streaks</span></button>
<button class="ach-filter-btn" data-filter="Trust" onclick="filterAchievements('Trust', this)">🛡️ <span data-i18n="trust_score">Trust</span></button>
<button class="ach-filter-btn" data-filter="XP" data-i18n="html_xp" onclick="filterAchievements('XP', this)">⭐ XP</button>
<button class="ach-filter-btn" data-filter="Calendar" onclick="filterAchievements('Calendar', this)">📅 <span data-i18n="calendar">Calendar</span></button>
<button class="ach-filter-btn" data-filter="Rare" data-i18n="html_rare" onclick="filterAchievements('Rare', this)">💎 Rare</button>
<button class="ach-filter-btn" data-filter="Legendary" data-i18n="html_legendary" onclick="filterAchievements('Legendary', this)">👑 Legendary</button>
<button class="ach-filter-btn" data-filter="unlocked" data-i18n="html_unlocked" onclick="filterAchievements('unlocked', this)">✅ Unlocked</button>
<button class="ach-filter-btn" data-filter="locked" data-i18n="html_locked" onclick="filterAchievements('locked', this)">🔒 Locked</button>
</div>
<div class="achievements-grid" id="achievements-grid">
