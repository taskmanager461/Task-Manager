<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport"/>
<!-- SEO Meta Tags -->
<meta content="Tobedone is your ultimate smart task manager. Organize your life, boost productivity, track your progress, and stay on top of your daily goals with our elegant app." name="description"/>
<meta content="task manager, to-do list, productivity app, tobedone, daily goals, habit tracker, organize life, todo" name="keywords"/>
<meta content="Tobedone" name="author"/>
<meta content="index, follow" name="robots"/>
<!-- Open Graph / Facebook -->
<meta content="website" property="og:type"/>
<meta content="Tobedone - The Ultimate Smart Task Manager" property="og:title"/>
<meta content="Organize your life, boost productivity, track your progress, and stay on top of your daily goals with our elegant app." property="og:description"/>
<meta content="/assets/app-logo-20260501.png" property="og:image"/>
<!-- Twitter -->
<meta content="summary_large_image" property="twitter:card"/>
<meta content="Tobedone - The Ultimate Smart Task Manager" property="twitter:title"/>
<meta content="Organize your life, boost productivity, track your progress, and stay on top of your daily goals with our elegant app." property="twitter:description"/>
<meta content="/assets/app-logo-20260501.png" property="twitter:image"/>
<title>Tobedone - The Ultimate Smart Task Manager</title>
<link href="styles.css?v=73" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet"/>
<link href="/src/styles/logo.css?v=23.0.0" rel="stylesheet"/>
<link href="manifest.json" rel="manifest"/>
<link href="/assets/app-logo-20260501.png?v=17" rel="icon" type="image/png"/>
<meta content="#000000" name="theme-color"/>
<link href="/static/icon-home-192-v7.png" rel="apple-touch-icon"/>
<!-- Chart.js -->
<script charset="UTF-8" src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- Critical: prevent black flash before CSS loads -->
<style>
        html, body {
            margin: 0; padding: 0;
        }
        #loading-overlay {
            position: fixed; inset: 0;
            background: #000000;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
<script>
        (function() {
            var isDark = localStorage.getItem('tm_dark_mode') !== '0';
            var bg = isDark ? '#000000' : '#ffffff';
            document.write('<style>#loading-overlay{background:' + bg + ' !important;}</style>');
        })();
    </script>
</head>
<body>
<script>
        (function () {
            var prefersDark = localStorage.getItem('tm_dark_mode');
            document.body.classList.add(prefersDark === '0' ? 'light-mode' : 'dark-mode');
        })();
    </script>
<div class="bg-lines-container">
<div class="bg-line bg-line-1"></div>
<div class="bg-line bg-line-2"></div>
<div class="bg-line bg-line-3"></div>
<div class="bg-line bg-line-4"></div>
<div class="bg-line bg-line-5"></div>
</div>
<div class="toast-container" id="toast-container"></div>
<!-- Auth Page -->
<div class="page" id="auth-page">
<div class="auth-container">
<img alt="Tobedone logo" class="auth-logo logo" src="/assets/logo_auth.png?v=22" style="width: 100% !important; max-width: 120px !important; height: auto !important; margin: 0 auto 0.25rem !important; display: block !important; object-fit: contain;"/>
<h1 class="main-title">
<span class="main-title-t" data-i18n="html_t">T</span><span class="main-title-rest" data-i18n="html_obedone">obedone</span>
</h1>
<p class="brand-tagline" data-i18n="html_plan_it_do_it_done">Plan it. Do it. Done.</p>
<div class="tabs">
<button class="tab active" id="tab-login" onclick="switchAuthTab('login')">
<i class="fas fa-user"></i>
<span data-i18n="login">Sign In</span>
</button>
<button class="tab" id="tab-signup" onclick="switchAuthTab('signup')">
<i class="fas fa-user-plus"></i>
<span data-i18n="signup">Sign Up</span>
</button>
</div>
<div class="auth-oauth">
<button class="btn oauth-btn full-width" id="google-signin-btn" type="button">
<span aria-hidden="true" class="oauth-icon"></span>
<span data-i18n="continue_with_google">Continue with Google</span>
</button>
</div>
<form class="auth-form active" id="login-form">
<div class="input-group">
<input autocomplete="email" data-i18n="email" id="login-email" placeholder="Email" required="" type="email"/>
</div>
<div class="input-group">
<input autocomplete="current-password" data-i18n="password" id="login-password" placeholder="Password" required="" type="password"/>
<button aria-label="Toggle password visibility" class="password-toggle" data-target="login-password" type="button">
<i aria-hidden="true" class="fas fa-eye"></i>
</button>
</div>
<button class="btn primary" data-i18n="login" type="submit">Sign In</button>
<button class="btn link-btn" data-i18n="forgot_password" id="forgot-password-link" type="button">Forgot password?</button>
</form>
<form class="auth-form" id="signup-form">
<div class="input-group">
<input autocomplete="name" data-i18n="full_name" id="signup-name" placeholder="Full Name" required="" type="text"/>
</div>
<div class="input-group">
<input autocomplete="username" data-i18n="username" id="signup-username" placeholder="Username" required="" type="text"/>
</div>
<div class="input-group">
<input autocomplete="email" data-i18n="email" id="signup-email" placeholder="Email" required="" type="email"/>
</div>
<div class="input-group">
<input autocomplete="new-password" data-i18n="password" id="signup-password" placeholder="Password" required="" type="password"/>
<button aria-label="Toggle password visibility" class="password-toggle" data-target="signup-password" type="button">
<i aria-hidden="true" class="fas fa-eye"></i>
</button>
</div>
<button class="btn primary" data-i18n="create_account" type="submit">Create Account</button>
</form>
<form class="auth-form" id="forgot-form">
<div class="auth-note" data-i18n="forgot_password_note">Enter your email and we’ll send you a reset link.</div>
<div class="input-group">
<input autocomplete="email" data-i18n="email" id="forgot-email" placeholder="Email" required="" type="email"/>
</div>
<button class="btn primary" data-i18n="send_reset_link" type="submit">Send reset link</button>
<div class="auth-divider"><span data-i18n="or">or</span></div>
<input autocomplete="one-time-code" data-i18n="reset_code" id="recovery-otp" inputmode="numeric" placeholder="Reset code" type="text"/>
<button class="btn secondary" data-i18n="use_code" id="recovery-otp-btn" type="button">Use code</button>
<button class="btn link-btn" data-i18n="back_to_login" id="forgot-back-link" type="button">Back to login</button>
</form>
<div class="auth-form" id="verify-form">
<div class="auth-note">
<div class="auth-note-title" data-i18n="verify_email_title">Verify your email</div>
<div class="auth-note-body" data-i18n="verify_email_body" id="verify-email-text">Check your inbox and click the verification link to continue.</div>
</div>
<div class="input-group">
<input autocomplete="one-time-code" data-i18n="verification_code" id="verify-otp" inputmode="numeric" placeholder="Verification code" type="text"/>
</div>
<button class="btn primary" data-i18n="verify_code" id="verify-otp-btn" type="button">Verify code</button>
<button class="btn secondary" data-i18n="resend_verification" id="resend-verification-btn" type="button">Resend verification email</button>
<button class="btn link-btn" data-i18n="back_to_login" id="verify-back-link" type="button">Back to login</button>
</div>
<form class="auth-form" id="reset-form">
<div class="auth-note">
<div class="auth-note-title" data-i18n="reset_password_title">Set a new password</div>
</div>
<div class="input-group">
<input autocomplete="new-password" data-i18n="new_password" id="reset-password" placeholder="New password" required="" type="password"/>
<button aria-label="Toggle password visibility" class="password-toggle" data-target="reset-password" type="button">
<i aria-hidden="true" class="fas fa-eye"></i>
</button>
</div>
<div class="input-group">
<input autocomplete="new-password" data-i18n="confirm_password" id="reset-password-confirm" placeholder="Confirm password" required="" type="password"/>
<button aria-label="Toggle password visibility" class="password-toggle" data-target="reset-password-confirm" type="button">
<i aria-hidden="true" class="fas fa-eye"></i>
</button>
</div>
<button class="btn primary" data-i18n="update_password" type="submit">Update password</button>
</form>
<div class="error-msg" id="auth-error"></div>
</div>
</div>
<!-- Main App Layout -->
<div class="page" data-i18n="html_top_bar_bottom_navigation" id="main-app">
<!-- Top Bar -->
<header class="top-bar">
<div class="top-bar-left">
<img alt="Logo" class="app-logo-small" src="/assets/logo_small.png?v=22"/>
<h2 class="app-title-small" data-i18n="html_obedone"><span data-i18n="html_t" style="color: var(--primary);">T</span>obedone</h2>
</div>
</header>
<div class="top-actions-float">
<button aria-label="Install App" class="icon-btn install-trigger" id="top-install-btn" style="display: none;">
<i class="fas fa-download"></i>
</button>
<button aria-label="Settings" class="icon-btn settings-trigger" onclick="toggleSettings()">
<i class="fas fa-cog"></i>
</button>
</div>
<main data-i18n="html_dashboard_view_formerly_reports_me_view_" id="content"> <!-- Dashboard View (formerly Reports) -->
<section class="view" data-i18n="html_monthly_calendar_moved_near_the_top" id="view-reports">
<div class="premium-header-card" style="width: 95%; margin: 0 auto 1.5rem auto; display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: transparent; border: none; box-shadow: none;">
<div>
<h1 data-i18n="dashboard" style="margin: 0; font-size: 1.6rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">Dashboard</h1>
</div>
</div>
<!-- Monthly Calendar (moved near the top) -->
<div class="card calendar-container" style="margin-bottom: 1.5rem;">
<div class="calendar-header">
<button class="btn secondary" onclick="changeDashboardMonth(-1)">❮</button>
<h2 data-i18n="html_month_year" id="dashboard-calendar-month-year">Month Year</h2>
<button class="btn secondary" onclick="changeDashboardMonth(1)">❯</button>
</div>
<div class="calendar-grid" data-i18n="html_calendar_injected_here" id="dashboard-calendar-grid">
<!-- Calendar injected here -->
</div>
</div>
<div class="hero-metric-grid" data-i18n="html_hero_metrics_injected_by_app_js" id="dashboard-hero-metrics">
<!-- Hero Metrics injected by app.js -->
</div>
<div class="card progress-section" style="margin-bottom: 1.5rem;">
<div class="progress-header">
<label data-i18n="daily_progress">Daily Progress</label>
<span class="priority-badge priority-low" data-i18n="html_1_0x_boost" id="multiplier-badge" style="display:none">1.0x Boost</span>
</div>
<div class="progress-bar"><div id="daily-progress-fill" style="width: 0%"></div></div>
</div>
<div class="card habits-today-card" style="margin-bottom: 1.5rem;">
<div class="identity-header">
<h3 data-i18n="today_habits">Today's Habits</h3>
<span class="priority-badge priority-medium" data-i18n="html_consistency">Consistency</span>
</div>
<div class="habit-list" id="today-habits-list"></div>
</div>
<div class="card" id="weekly-summary" style="margin-top: 1.5rem; display: none;">
<h3 data-i18n="html_weekly_summary">Weekly Summary</h3>
<div id="weekly-summary-content"></div>
</div>
</section>
<!-- Me View -->
<section class="view" data-i18n="html_identity_card_re_added_moved_below_profi" id="view-me">
<div class="premium-header-card" style="width: 95%; margin: 0 auto 1.5rem auto; display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: transparent; border: none; box-shadow: none;">
<div>
<h1 data-i18n="me" style="margin: 0; font-size: 1.6rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">Me</h1>
</div>
</div>
<div class="card" style="margin-bottom: 1.5rem;">
<div style="display: flex; align-items: center; gap: 1rem;">
<div class="profile-avatar-wrap">
<img alt="Profile avatar" class="profile-avatar-img" id="profile-avatar" src="https://ui-avatars.com/api/?name=User&amp;background=0a86ff&amp;color=fff&amp;size=128&amp;bold=true"/>
<button aria-label="Edit profile photo" class="profile-avatar-edit" id="profile-avatar-edit" type="button">
<img alt="Edit" src="/assets/pencil-edit.png"/>
</button>
<input accept="image/*" id="profile-avatar-input" style="display:none;" type="file"/>
</div>
<div style="flex: 1; display: flex; flex-direction: column; gap: 0.25rem; justify-content: center;">
<div class="profile-display-name" data-i18n="html_user" id="profile-name" style="margin: 0; font-size: 1.5rem;">User</div>
<div class="profile-display-username" data-i18n="html_user" id="profile-username" style="margin: 0; font-size: 1rem; opacity: 0.7;">@user</div>
</div>
</div>
<form id="profile-edit-form" style="margin-top: 2rem;">
<div class="form-row" data-i18n="html_full_name_group_username_group" style="flex-direction: column; gap: 1.5rem;">
<!-- Full Name Group -->
<div class="form-group" style="display: flex; flex-direction: column; gap: 0.5rem;">
<label data-i18n="full_name" style="font-weight: 700; color: var(--text-secondary);">Full Name</label>
<div style="display: flex; gap: 1rem; align-items: center; background: rgba(255,255,255,0.03); padding: 0.5rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05);">
<input autocomplete="name" data-i18n="full_name" id="profile-name-input" placeholder="Full Name" readonly="" style="flex: 1; background: transparent; border: none; padding: 0.5rem 1rem; font-size: 1rem; color: var(--text-primary); outline: none;" type="text"/>
<button class="primary-link-btn-small" onclick="enableEdit('profile-name-input')" style="min-width: 120px;" type="button">
<span data-i18n="change_name">Change Name</span>
</button>
</div>
</div>
<!-- Username Group -->
<div class="form-group" style="display: flex; flex-direction: column; gap: 0.5rem;">
<label data-i18n="username" style="font-weight: 700; color: var(--text-secondary);">Username</label>
<div style="display: flex; gap: 1rem; align-items: center; background: rgba(255,255,255,0.03); padding: 0.5rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05);">
<input autocomplete="username" data-i18n="username" id="profile-username-input" placeholder="Username" readonly="" style="flex: 1; background: transparent; border: none; padding: 0.5rem 1rem; font-size: 1rem; color: var(--text-primary); outline: none;" type="text"/>
<button class="primary-link-btn-small" onclick="enableEdit('profile-username-input')" style="min-width: 120px;" type="button">
<span data-i18n="change_username">Change Username</span>
</button>
</div>
</div>
</div>
<div class="form-actions" style="margin-top: 2rem;">
<div style="display:flex; gap: 1rem; width: 100%;">
<button class="btn secondary" data-i18n="html_cancel" disabled="" id="profile-cancel-btn" style="flex: 1;" type="button">Cancel</button>
<button class="btn primary" data-i18n="html_save_changes" disabled="" id="profile-save-btn" style="flex: 1;" type="submit">Save Changes</button>
</div>
</div>
</form>
</div>
<!-- Identity Card (Re-added, moved below Profile Card) -->
<div class="card identity-card" id="identity-card-section" style="margin-bottom: 1.5rem;">
<div class="identity-header">
<div class="identity-title-group">
<div class="identity-avatar-icon">
<i class="fas fa-user-shield"></i>
</div>
<div>
<h3 class="profile-display-name" data-i18n="html_user" id="identity-name-display" style="margin: 0;">User</h3>
<p class="profile-display-username" data-i18n="html_user" id="identity-username-display" style="font-size:0.72rem; color:var(--text-secondary); margin:0;">@user</p>
</div>
</div>
<span class="identity-level-pill" data-i18n="html_level_1" id="identity-level-badge">
<i class="fas fa-star"></i> Level 1
                        </span>
</div>
<div class="identity-progress-wrap" style="margin-top: 1.25rem; margin-bottom: 1.25rem;">
<div class="progress-bar identity-progress-bar">
<div class="identity-xp-fill" id="identity-xp-fill" style="width: 0%"></div>
</div>
<div class="identity-xp-text" data-i18n="html_xp_0_100" id="identity-xp-text">XP 0/100</div>
</div>
<div class="identity-stats" data-i18n="html_injected_by_app_js" id="identity-stats" style="margin-bottom: 1rem;">
<!-- Injected by app.js -->
</div>
<div class="identity-trust-score-row" style="display:flex; justify-content:space-between; align-items:center; background:rgba(255,255,255,0.02); padding:0.75rem 1rem; border-radius:12px; margin-bottom: 1rem; border: 1px solid rgba(255,255,255,0.05);">
<span data-i18n="html_self_trust_score" style="font-size:0.9rem; font-weight:600; color:var(--text-secondary);">Self Trust Score</span>
<span id="identity-trust-value" style="font-size:1.4rem; font-weight:900; color:#fbbf24;">0.0</span>
</div>
<div class="identity-badges" data-i18n="html_badges_summary_list" id="identity-badges">
<!-- Badges summary list -->
</div>
</div>
<div class="card for-you-card" style="margin-bottom: 1.5rem;">
<div class="identity-header">
<h3 data-i18n="html_for_you">For You</h3>
<span class="priority-badge priority-low" data-i18n="html_adaptive" id="for-you-pressure">Adaptive</span>
</div>
<div class="for-you-list" id="for-you-list"></div>
</div>
<div class="card score-comparison" id="score-comparison" style="display: none; margin-bottom: 1.5rem;">
<span id="score-comparison-text"></span>
</div>
<div class="card missed-tasks-alert" id="missed-tasks-alert" style="display: none; margin-bottom: 1.5rem;">
<span id="missed-tasks-text"></span>
</div>
<!-- Insights Section embedded in Me -->
<div class="card" style="margin-bottom: 1.5rem;">
<div class="identity-header" style="margin-bottom:1rem;">
<h3 data-i18n="html_your_analytics"><i class="fas fa-chart-line" style="margin-right:0.5rem; color:var(--primary);"></i>Your Analytics</h3>
<button class="btn secondary" data-i18n="html_full_report" onclick="showView('insights')" style="font-size:0.7rem; padding:0.3rem 0.7rem;">Full Report</button>
</div>
<div class="insights-container" data-i18n="html_smart_insights_mini_feed_injected_by_js" id="me-smart-insights" style="margin-bottom:1rem;">
<!-- Smart insights mini-feed injected by JS -->
</div>
<div class="weekly-summary-stats" style="margin-bottom:1rem;">
<div class="weekly-summary-stat">
<span class="label" data-i18n="html_best_day">Best Day</span>
<span class="value" id="me-insight-best-day">—</span>
</div>
<div class="weekly-summary-stat">
<span class="label" data-i18n="html_goal_rate">Goal Rate</span>
<span class="value" id="me-goal-completion-rate">0%</span>
</div>
<div class="weekly-summary-stat">
<span class="label" data-i18n="html_tasks_30d">Tasks (30d)</span>
<span class="value" id="me-tasks-30d">0</span>
</div>
</div>
<div class="chart-grid" style="grid-template-columns:1fr;">
<div class="chart-container" style="padding:0;">
<h3 data-i18n="weekly_trend" style="font-size:0.85rem; margin-bottom:0.75rem;">Weekly Trend</h3>
<canvas id="me-weekly-trend-chart"></canvas>
</div>
</div>
</div>
</section>
<!-- Calendar View (Removed or integrated into Dashboard, keeping hidden container for API compatibility if needed, but not in bottom menu) -->
<section class="view" id="view-calendar" style="display:none !important;">
<div class="view-header">
<h1 data-i18n="calendar">Calendar</h1>
</div>
<div class="card calendar-container">
<div class="calendar-header">
<button class="btn secondary" onclick="changeMonth(-1)">❮</button>
<h2 data-i18n="html_month_year" id="calendar-month-year">Month Year</h2>
<button class="btn secondary" onclick="changeMonth(1)">❯</button>
</div>
<div class="calendar-grid" id="calendar-grid"></div>
</div>
<div class="day-tasks-list" id="day-tasks-container"></div>
</section>
<!-- Insights View (Analytics Only) -->
<section class="view" data-i18n="html_personal_records_card_dynamic_intelligen" id="view-insights">
<div class="premium-header-card" style="width: 95%; margin: 0 auto 1.5rem auto; display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: transparent; border: none; box-shadow: none;">
<div>
<h1 data-i18n="insights" style="margin: 0; font-size: 1.6rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">Insights</h1>
</div>
</div>
<div class="insights-container" data-i18n="html_smart_insights_will_be_injected_here" id="smart-insights-container" style="margin-bottom: 2rem;">
<!-- Smart insights will be injected here -->
</div>
<div class="card" style="margin-bottom: 1.5rem;">
<h3 data-i18n="html_goal_analytics" style="margin-bottom: 1rem;">Goal Analytics</h3>
<div class="weekly-summary-stats">
<div class="weekly-summary-stat">
<span class="label" data-i18n="html_completion_rate">Completion Rate</span>
<span class="value" id="goal-completion-rate">0%</span>
</div>
<div class="weekly-summary-stat">
<span class="label" data-i18n="html_achieved_failed">Achieved / Failed</span>
<span class="value" id="goal-achieved-failed">0 / 0</span>
</div>
<div class="weekly-summary-stat">
<span class="label" data-i18n="html_avg_completion_time">Avg Completion Time</span>
<span class="value" data-i18n="html_0d" id="goal-average-time">0d</span>
</div>
</div>
</div>
<div class="insights-container" style="margin-bottom: 1.5rem;">
<div class="insight-card">
<span class="icon"><i class="fas fa-lightbulb"></i></span>
<div class="insight-content">
<h4 data-i18n="productive_day">Most Productive Day</h4>
<p data-i18n="html_analyzing_patterns" id="insight-best-day">Analyzing patterns...</p>
</div>
</div>
<div class="insight-card">
<span class="icon"><i class="fas fa-bolt"></i></span>
<div class="insight-content">
<h4 data-i18n="productive_hour">Most Productive Hour</h4>
<p data-i18n="html_analyzing_patterns" id="insight-best-hour">Analyzing patterns...</p>
</div>
</div>
<div class="insight-card" style="border-left: 4px solid var(--error);">
<span class="icon"><i class="fas fa-exclamation-triangle"></i></span>
<div class="insight-content">
<h4 data-i18n="failure_patterns">Failure Patterns</h4>
<p data-i18n="html_analyzing_patterns" id="insight-failure-pattern">Analyzing patterns...</p>
</div>
</div>
</div>
<!-- Personal Records Card -->
<div class="card personal-records-card" style="margin-bottom: 1.5rem;">
<div class="identity-header">
<h3 data-i18n="html_personal_records">🏆 Personal Records</h3>
</div>
