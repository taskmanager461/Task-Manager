</div>
</div>
<div class="achievements-ring" id="achievements-completion-ring">
<svg class="ring-svg" viewbox="0 0 36 36">
<circle class="ring-bg" cx="18" cy="18" r="15.9"></circle>
<circle class="ring-fill" cx="18" cy="18" id="ring-progress-circle" r="15.9" stroke-dasharray="0 100"></circle>
</svg>
<span class="ring-text" id="ring-percent-text">0%</span>
</div>
</div>
<div class="achievements-stats-bar">
<div class="ach-stat ach-stat-common">
