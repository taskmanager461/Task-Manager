<!-- Tasks injected here -->
</div>
<div class="task-list" id="tasks-history-list" style="margin-top: 1.5rem;"></div>
<div style="text-align:center; margin-top: 0.5rem; margin-bottom: 1rem;">
<button class="btn primary" id="tasks-history-btn" onclick="loadInlineHistory('tasks')" style="width:100%; font-size:0.85rem; gap:0.5rem;">
<i class="fas fa-clock-rotate-left"></i> <span data-i18n="view_tasks_history">View Completed Tasks History</span>
</button>
</div>
</div>
