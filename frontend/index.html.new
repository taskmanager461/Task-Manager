<span data-i18n="html_0_opened" id="fs-stat-opened">0 Opened</span>
</div>
</div>
<!-- Compose Form -->
<div class="future-self-compose">
<div class="future-self-compose-header" onclick="toggleFutureSelfForm()">
<span><i class="fas fa-plus-circle" style="margin-right:0.5rem; color:var(--primary);"></i><span data-i18n="write_future">Write a message to your future self</span></span>
<i class="fas fa-chevron-down" id="fs-compose-chevron"></i>
</div>
<div id="future-self-compose-body" style="display:none; margin-top:1rem;">
<input data-i18n="message_title" id="fs-title" placeholder="Message title (e.g. My fitness goal)" style="width:100%; margin-bottom:0.75rem; padding:0.75rem; border-radius:12px; border:1px solid var(--border-color); background:var(--bg-secondary); color:var(--text-primary); font-size:0.9rem;" type="text"/>
<textarea data-i18n="write_message" id="fs-message" placeholder="Write a message to your future self... goals, promises, predictions, reminders, or motivation." rows="4" style="width:100%; margin-bottom:0.75rem; padding:0.75rem; border-radius:12px; border:1px solid var(--border-color); background:var(--bg-secondary); color:var(--text-primary); font-size:0.9rem; resize:vertical;"></textarea>
<div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.75rem;">
<select id="fs-delivery" style="flex:1; padding:0.6rem; border-radius:10px; border:1px solid var(--border-color); background:var(--bg-secondary); color:var(--text-primary);">
<option data-i18n="one_week" value="1_week">📅 Open in 1 Week</option>
<option data-i18n="one_month" selected="" value="1_month">📅 Open in 1 Month</option>
<option data-i18n="three_months_long" value="3_months">📅 Open in 3 Months</option>
<option data-i18n="six_months_long" value="6_months">📅 Open in 6 Months</option>
<option data-i18n="one_year_long" value="1_year">📅 Open in 1 Year</option>
</select>
<select id="fs-category" style="flex:1; padding:0.6rem; border-radius:10px; border:1px solid var(--border-color); background:var(--bg-secondary); color:var(--text-primary);">
<option data-i18n="goals" value="goal">🎯 Goal</option>
<option data-i18n="html_promise" value="promise">🤝 Promise</option>
<option data-i18n="html_prediction" value="prediction">🔮 Prediction</option>
<option data-i18n="html_reminder" value="reminder">🔔 Reminder</option>
<option data-i18n="html_motivational" selected="" value="motivational">💪 Motivational</option>
</select>
</div>
<button class="btn primary" onclick="submitFutureSelfMessage()" style="width:100%;">
<i class="fas fa-paper-plane" style="margin-right:0.5rem;"></i><span data-i18n="send_future">Send to Future Self</span>
</button>
</div>
</div>
<!-- Archive -->
<div class="future-self-archive" data-i18n="html_loaded_dynamically" id="future-self-archive" style="margin-top:1.25rem;">
<!-- Loaded dynamically -->
</div>
</div>
</section>
<!-- Tasks View -->
<section class="view active" id="view-tasks">
<div class="premium-header-card" style="width: 95%; margin: 0 auto 1.5rem auto; display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: transparent; border: none; box-shadow: none;">
<div>
<h1 data-i18n="tasks" id="tasks-goals-title" style="margin: 0; font-size: 1.6rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">Tasks</h1>
<p data-i18n="focus_today" id="tasks-goals-subtitle" style="margin: 0.25rem 0 0 0; font-size: 0.85rem; color: var(--text-secondary);">Focus on what matters today.</p>
</div>
<button class="btn primary" id="tasks-goals-add-btn" onclick="toggleCurrentForm()" style="border-radius: 12px; padding: 0.65rem 1.25rem; font-weight: 700; display: flex; align-items: center; gap: 0.4rem; box-shadow: 0 4px 15px rgba(10, 134, 255, 0.25);">
<i class="fas fa-plus-circle" style="font-size: 1.1em;"></i> <span data-i18n="new_task" id="tasks-goals-add-text">New Task</span>
</button>
</div>
<div class="card" style="margin-bottom: 1.5rem;">
<div class="tabs" style="margin: 0;">
<button class="tab active" data-i18n="tasks" id="tab-tasks-only" onclick="switchTasksGoalsTab('tasks')">Tasks</button>
<button class="tab" data-i18n="goals_tab" id="tab-goals-only" onclick="switchTasksGoalsTab('goals')">Goals</button>
<button class="tab" data-i18n="habits_tab" id="tab-habits-only" onclick="switchTasksGoalsTab('habits')">Habits</button>
</div>
</div>
<div id="smart-suggestion-container" style="display: none;"></div>
