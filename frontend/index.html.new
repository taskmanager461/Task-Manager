<!-- Settings View -->
<section class="view" data-i18n="html_instructions_button" id="view-settings">
<div class="premium-header-card" style="width: 100%; margin: 0 auto 1.5rem auto; display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; background: transparent; border: none; box-shadow: none;">
<div>
<h1 data-i18n="settings" style="margin: 0; font-size: 1.8rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">Settings</h1>
</div>
<button aria-label="Close Settings" class="settings-close-btn" onclick="toggleSettings()">
<i class="fas fa-times" style="font-size: 0.9rem;"></i>
</button>
</div>
<div class="card settings-styled-card">
<h3 data-i18n="theme" style="margin-bottom: 1rem;">Theme</h3>
<div class="settings-row">
<span data-i18n="toggle_dark">Toggle Dark Mode</span>
<label class="switch">
<input id="dark-mode-switch" onchange="toggleDarkMode()" type="checkbox"/>
<span class="slider round"></span>
</label>
</div>
</div>
<div class="card settings-styled-card">
<h3 data-i18n="language" style="margin-bottom: 1rem;">Language</h3>
<select id="lang-selector" onchange="changeLanguage(this.value)" style="width: 100%; padding: 0.6rem 1rem; border-radius: 8px; border: 1px solid rgba(10,134,255,0.4); background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
<option data-i18n="html_english" value="en">English</option>
<option value="el">Ελληνικά</option>
<option data-i18n="html_espa_ol" value="es">Español</option>
<option data-i18n="html_fran_ais" value="fr">Français</option>
<option data-i18n="html_deutsch" value="de">Deutsch</option>
<option data-i18n="html_italiano" value="it">Italiano</option>
<option data-i18n="html_portugu_s" value="pt">Português</option>
<option value="ru">Русский</option>
<option value="ja">日本語</option>
<option value="zh">中文</option>
<option value="ar">العربية</option>
</select>
</div>
<!-- Instructions Button -->
<button class="settings-action-btn" onclick="openInstructionsModal()">
<i class="fas fa-book-open" style="color: var(--primary);"></i> <span data-i18n="instructions_btn">Οδηγίες για Νέους Χρήστες</span>
</button>
<div class="card settings-styled-card">
<h3 data-i18n="app_info" style="margin-bottom: 1rem;">App Info</h3>
<p style="margin-bottom: 1rem; color: var(--text-secondary); font-size: 0.9rem;"><span data-i18n="version">Version</span>: 4.0.0</p>
<button class="settings-action-btn" data-i18n="force_update" onclick="forceUpdateApp()">Force Update App</button>
<button class="settings-action-btn" data-i18n="install_app" id="install-btn" style="display:none;">Install App</button>
<button class="settings-logout-btn" onclick="logout()">
<i class="fas fa-sign-out-alt" style="margin-right: 0.5rem;"></i>
<span data-i18n="logout">Logout</span>
</button>
</div>
</section>
</main>
