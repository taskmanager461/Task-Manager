<button class="nav-item" onclick="showView('progress')">
<span class="nav-icon"><i class="fas fa-crown"></i></span>
<span class="nav-label" data-i18n="progress">Progress</span>
</button>
<button class="nav-item" onclick="showView('me')">
<span class="nav-icon"><i class="fas fa-user"></i></span>
<span class="nav-label" data-i18n="me">Me</span>
</button>
</nav>
</div>
<div class="task-form-modal" id="task-form-container">
<form id="add-task-form">
<h3 data-i18n="new_task">New Task</h3>
<input data-i18n="task_placeholder" id="task-title" placeholder="What needs to be done?" required="" type="text"/>
<div class="form-row">
<div class="form-group">
<label data-i18n="date">Date</label>
<input id="task-date" required="" type="date"/>
</div>
<div class="form-group">
<label data-i18n="html_start">Start</label>
<input id="task-start-time" type="time"/>
</div>
<div class="form-group">
<label data-i18n="html_finish">Finish</label>
<input id="task-time" required="" type="time"/>
</div>
</div>
<div class="form-row">
<div class="form-group">
<label data-i18n="category">Category</label>
<input id="task-category" placeholder="General" type="text" value="General"/>
</div>
<div class="form-group">
<label data-i18n="priority">Priority</label>
<select id="task-priority">
<option data-i18n="low" value="low">Low</option>
<option data-i18n="medium" selected="" value="medium">Medium</option>
<option data-i18n="high" value="high">High</option>
</select>
</div>
</div>
<div style="display:none">
<select id="task-difficulty"><option selected="" value="medium"></option></select>
<select id="task-recurring"><option selected="" value="none"></option></select>
<input id="task-due-date" type="date"/>
</div>
<div class="link-controls">
<div class="link-toggle-group" style="display: flex; gap: 0.5rem;">
<button class="link-toggle-btn" id="btn-link-goal" onclick="toggleTaskLink('goal')" style="flex: 1;" type="button">
<i class="fas fa-bullseye"></i>
<span data-i18n="html_goal_link">Goal Link</span>
</button>
<button class="link-toggle-btn" id="btn-link-habit" onclick="toggleTaskLink('habit')" style="flex: 1;" type="button">
<i class="fas fa-repeat"></i>
<span data-i18n="html_habit_link">Habit Link</span>
</button>
</div>
<div class="link-panel" id="link-goal-panel" style="display:none; margin-top: 0.5rem;">
<select id="task-goal-select">
<option data-i18n="html_select_a_goal" value="">Select a goal...</option>
</select>
</div>
<div class="link-panel" id="link-habit-panel" style="display:none; margin-top: 0.5rem;">
<select id="task-habit-select">
<option data-i18n="html_select_a_habit" value="">Select a habit...</option>
</select>
</div>
</div>
<div class="form-actions">
<button class="btn secondary" data-i18n="cancel" onclick="toggleTaskForm()" type="button">Cancel</button>
<button class="btn primary" data-i18n="add_task" type="submit">Add Task</button>
</div>
</form>
</div>
<div class="task-form-modal" id="goal-form-container">
<form id="add-goal-form">
<h3 data-i18n="html_new_goal">New Goal</h3>
<input id="goal-title" placeholder="Goal title" required="" type="text"/>
<div class="form-row">
<div class="form-group">
<label data-i18n="html_category">Category</label>
<input id="goal-category" placeholder="General" required="" type="text" value="General"/>
</div>
<div class="form-group">
<label data-i18n="html_goal_type">Goal Type</label>
<select id="goal-type">
<option data-i18n="html_today_short_length" value="today">Today (Short Length)</option>
<option data-i18n="html_tomorrow_short_length" value="tomorrow">Tomorrow (Short Length)</option>
<option data-i18n="html_1_3_days_short_length" value="three_days">1-3 days (Short Length)</option>
<option data-i18n="html_1_week_medium_length" value="one_week">1 week (Medium Length)</option>
<option data-i18n="html_1_2_weeks_medium_length" selected="" value="two_weeks">1-2 weeks (Medium Length)</option>
<option data-i18n="html_1_month_medium_length" value="one_month">1 month (Medium Length)</option>
<option data-i18n="html_3_months_long_length" value="three_months">3 months (Long Length)</option>
<option data-i18n="html_6_months_long_length" value="six_months">6 months (Long Length)</option>
<option data-i18n="html_1_year_long_length" value="one_year">1 year (Long Length)</option>
<option data-i18n="html_1_year_long_length" value="one_year_plus">1 year+ (Long Length)</option>
</select>
</div>
</div>
<div class="form-row">
<div class="form-group">
<label data-i18n="html_deadline">Deadline</label>
<select id="goal-deadline-preset" onchange="handleGoalDeadlinePreset()">
<option data-i18n="html_tomorrow" value="tomorrow">Tomorrow</option>
<option data-i18n="html_1_week" value="week">1 Week</option>
<option data-i18n="html_1_month" value="month">1 Month</option>
<option data-i18n="html_custom_date" value="custom">Custom Date</option>
</select>
</div>
<div class="form-group">
<label data-i18n="html_custom_deadline">Custom Deadline</label>
<input disabled="" id="goal-custom-deadline" type="date"/>
</div>
</div>
<div class="form-actions">
<button class="btn secondary" data-i18n="html_cancel" onclick="toggleGoalForm()" type="button">Cancel</button>
<button class="btn primary" data-i18n="html_create_goal" type="submit">Create Goal</button>
</div>
</form>
</div>
<div class="task-form-modal" id="habit-form-container">
<form id="add-habit-form">
<h3 data-i18n="html_new_habit">New Habit</h3>
<input id="habit-title" placeholder="Habit title" required="" type="text"/>
<div class="form-row">
<div class="form-group">
<label data-i18n="html_category">Category</label>
<input id="habit-category" placeholder="General" required="" type="text" value="General"/>
</div>
<div class="form-group">
<label data-i18n="html_preferred_time">Preferred Time</label>
<input id="habit-time" type="time"/>
</div>
</div>
<div class="form-row">
<div class="form-group" style="width: 100%;">
<label data-i18n="html_link_to_goal"><i class="fas fa-bullseye"></i> Link to Goal</label>
<select id="habit-goal-select">
<option data-i18n="html_no_link" value="">No Link</option>
</select>
</div>
</div>
<div class="form-row">
<div class="form-group">
<label data-i18n="html_frequency">Frequency</label>
<select id="habit-frequency" onchange="toggleHabitDaysSelector(this.value)">
<option data-i18n="html_daily" value="daily">Daily</option>
<option data-i18n="html_specific_days" value="weekly">Specific Days</option>
</select>
</div>
<div class="form-group" id="habit-days-group" style="display:none;">
<label data-i18n="html_days">Days</label>
<div class="habit-days-picker aesthetic">
<label class="day-pill"><input type="checkbox" value="0"/><span data-i18n="html_m">M</span></label>
<label class="day-pill"><input type="checkbox" value="1"/><span data-i18n="html_t">T</span></label>
<label class="day-pill"><input type="checkbox" value="2"/><span data-i18n="html_w">W</span></label>
<label class="day-pill"><input type="checkbox" value="3"/><span data-i18n="html_t">T</span></label>
<label class="day-pill"><input type="checkbox" value="4"/><span data-i18n="html_f">F</span></label>
<label class="day-pill"><input type="checkbox" value="5"/><span data-i18n="html_s">S</span></label>
<label class="day-pill"><input type="checkbox" value="6"/><span data-i18n="html_s">S</span></label>
</div>
</div>
</div>
<div class="form-actions">
<button class="btn secondary" data-i18n="html_cancel" onclick="toggleHabitForm()" type="button">Cancel</button>
<button class="btn primary" data-i18n="html_create_habit" type="submit">Create Habit</button>
</div>
</form>
</div>
<div class="task-form-modal" id="goal-reflection-modal">
<form id="goal-reflection-form">
<h3 data-i18n="html_goal_reflection">Goal Reflection</h3>
<div class="form-group">
<label data-i18n="html_what_went_well">What went well?</label>
<textarea id="reflection-went-well" placeholder="Tell us about what worked..." rows="3"></textarea>
</div>
<div class="form-group">
<label data-i18n="html_what_didn_t_go_well">What didn't go well?</label>
<textarea id="reflection-didnt-go-well" placeholder="What could be improved..." rows="3"></textarea>
</div>
<div class="form-actions">
<button class="btn secondary" data-i18n="html_skip" onclick="closeReflectionModal()" type="button">Skip</button>
<button class="btn primary" data-i18n="html_save_reflection" type="submit">Save Reflection</button>
</div>
</form>
</div>
<!-- Share Modal -->
<div class="task-form-modal" id="share-modal">
<div class="share-modal-content" data-i18n="html_share_card_preview_share_actions_profile">
<h2 data-i18n="html_share_your_progress" style="margin-bottom: 1rem; text-align: center;">Share Your Progress</h2>
<!-- Share Card Preview -->
<div class="share-card" id="share-card">
<div class="share-card-header">
<img alt="Tobedone Logo" class="share-logo" src="/assets/logo_auth.png?v=22"/>
<h3 data-i18n="html_username" id="share-username">Username</h3>
</div>
<div class="share-card-stats">
<div class="share-stat">
<span class="share-stat-label" data-i18n="html_level">Level</span>
<span class="share-stat-value" id="share-level">1</span>
</div>
<div class="share-stat">
<span class="share-stat-label" data-i18n="html_xp">XP</span>
<span class="share-stat-value" id="share-xp">0</span>
</div>
<div class="share-stat">
<span class="share-stat-label" data-i18n="html_streak">Streak</span>
<span class="share-stat-value" id="share-streak">0</span>
</div>
<div class="share-stat">
<span class="share-stat-label" data-i18n="html_completed_tasks">Completed Tasks</span>
<span class="share-stat-value" id="share-completed-tasks">0</span>
</div>
<div class="share-stat">
<span class="share-stat-label" data-i18n="html_goals_achieved">Goals Achieved</span>
<span class="share-stat-value" id="share-goals-achieved">0</span>
</div>
</div>
<div class="share-card-footer">
<span data-i18n="html_obedone"><span data-i18n="html_t" style="color: var(--primary);">T</span>obedone</span>
</div>
</div>
<!-- Share Actions -->
<div class="share-actions">
<button class="btn primary" data-i18n="html_download" onclick="downloadShareCard()" style="flex: 1;">
<i class="fas fa-download" style="margin-right: 0.5rem;"></i> Download
                </button>
<button class="btn secondary" data-i18n="html_copy_text" onclick="copyShareText()" style="flex: 1;">
<i class="fas fa-copy" style="margin-right: 0.5rem;"></i> Copy Text
                </button>
<button class="btn secondary" data-i18n="html_share" onclick="nativeShare()" style="flex: 1;">
<i class="fas fa-share" style="margin-right: 0.5rem;"></i> Share
                </button>
</div>
<!-- Profile Link -->
<div class="profile-link-section">
<label data-i18n="html_profile_link" style="margin-bottom: 0.5rem; display: block;">Profile Link</label>
<div style="display: flex; gap: 0.5rem;">
<input id="profile-link" readonly="" style="flex: 1; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-secondary); color: var(--text-primary);" type="text"/>
<button class="btn secondary" onclick="copyProfileLink()">
<i class="fas fa-copy"></i>
</button>
</div>
</div>
<div class="form-actions" style="margin-top: 1.5rem;">
<button class="btn secondary" data-i18n="html_close" onclick="closeShareModal()" style="width: 100%;" type="button">Close</button>
</div>
</div>
</div>
<!-- Crop Image Modal -->
<div class="modal" id="crop-modal">
<div class="modal-content glass-card" style="max-width: 500px;">
<div class="modal-header">
<h3 data-i18n="html_adjust_profile_photo">Adjust Profile Photo</h3>
</div>
<div class="crop-container" style="max-height: 400px; overflow: hidden; margin: 1rem 0; border-radius: 12px;">
<img id="crop-image" src="" style="max-width: 100%; display: block;"/>
</div>
<div style="display: flex; gap: 1rem;">
<button class="btn secondary" data-i18n="html_cancel" id="crop-cancel-btn" style="flex: 1;" type="button">Cancel</button>
<button class="btn primary" data-i18n="html_crop_save" id="crop-save-btn" style="flex: 1;" type="button">Crop &amp; Save</button>
</div>
</div>
</div>
<!-- Instructions Modal -->
<div class="modal" id="instructions-modal">
<div class="modal-content glass-card" style="max-width: 450px; padding: 2rem;">
<div class="modal-header" style="margin-bottom: 1.5rem; text-align: center;">
<div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(10, 134, 255, 0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
<i class="fas fa-book-open" style="color: var(--primary); font-size: 1.5rem;"></i>
</div>
<h3 data-i18n="inst_title" style="font-size: 1.4rem; margin-bottom: 0.5rem;">Οδηγίες Χρήσης</h3>
<p data-i18n="inst_subtitle" style="color: var(--text-secondary); font-size: 0.9rem; margin: 0;">Όλα όσα πρέπει να ξέρετε για το Tobedone</p>
</div>
<div class="instructions-content" style="max-height: 50vh; overflow-y: auto; padding-right: 0.5rem; text-align: left;">
<div style="margin-bottom: 1.5rem;">
<h4 style="color: var(--text-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-tasks" style="color: var(--primary);"></i> <span data-i18n="inst_tasks_title">Tasks (Εργασίες)</span></h4>
<p data-i18n="inst_tasks_desc" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0;">Δημιουργήστε νέες εργασίες πατώντας το '+'. Μπορείτε να ορίσετε προτεραιότητα και κατηγορία. Όταν τελειώσετε, πατήστε το κυκλικό κουτάκι για να την ολοκληρώσετε και να κερδίσετε πόντους.</p>
</div>
<div style="margin-bottom: 1.5rem;">
<h4 style="color: var(--text-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-chart-line" style="color: var(--primary);"></i> <span data-i18n="inst_dash_title">Dashboard</span></h4>
<p data-i18n="inst_dash_desc" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0;">Εδώ βλέπετε την πρόοδό σας. Παρακολουθήστε πόσες εργασίες ολοκληρώσατε την εβδομάδα και δείτε τα διαγράμματα παραγωγικότητας.</p>
</div>
<div style="margin-bottom: 1.5rem;">
<h4 style="color: var(--text-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-crown" style="color: var(--primary);"></i> <span data-i18n="inst_prog_title">Progress &amp; Badges</span></h4>
<p data-i18n="inst_prog_desc" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0;">Κάθε εργασία σας δίνει XP. Συγκεντρώστε XP για να ανεβείτε επίπεδο (Level Up). Ξεκλειδώστε συλλεκτικά Badges καθώς πετυχαίνετε νέους στόχους!</p>
</div>
<div style="margin-bottom: 1.5rem;">
<h4 style="color: var(--text-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-hand-pointer" style="color: var(--primary);"></i> <span data-i18n="inst_gestures_title">Gestures &amp; Πλοήγηση</span></h4>
<p data-i18n="inst_gestures_desc" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0;">Κάντε Swipe (σύρετε την οθόνη) αριστερά ή δεξιά για να μεταβείτε γρήγορα στις υπόλοιπες σελίδες της εφαρμογής.</p>
</div>
</div>
<div class="form-actions" style="margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
<button class="btn primary" data-i18n="got_it" onclick="closeInstructionsModal()" style="width: 100%;" type="button">Κατάλαβα</button>
</div>
</div>
</div>
<div class="loading-overlay active loading-sequence" id="loading-overlay">
<div aria-hidden="true" class="loading-content">
<div class="logo-draw-loader">
<img alt="Logo" class="logo-modern-mark" src="/assets/logo_small.png?v=26"/>
</div>
</div>
</div>
<script charset="UTF-8" src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.1/dist/umd/supabase.min.js"></script>
<script charset="UTF-8" src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script charset="UTF-8" src="assets.js?v=17.0.0"></script>
<script charset="UTF-8" src="badge_assets.js?v=36.0.0"></script>
<script charset="UTF-8" src="app.js?v=41.0.0"></script>
<script>
        // Logos are pre-sized; no JS resizing needed to avoid flicker.
        document.addEventListener('DOMContentLoaded', function() {
            // intentionally empty — sizes are set in CSS
        });
    </script>
</body>
</html>
